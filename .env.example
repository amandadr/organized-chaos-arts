# Public site URL (used for canonical/SEO later)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity ---
# Create a project at https://www.sanity.io/manage then fill these in.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token for published reads (if the dataset is private) and draft/preview
SANITY_API_READ_TOKEN=
# Editor token for `npm run sanity:seed` only (server-only, not used by the site)
SANITY_API_WRITE_TOKEN=

# --- Supabase (not configured yet) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (not configured yet) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
